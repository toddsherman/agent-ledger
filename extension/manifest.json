{
  "manifest_version": 3,
  "name": "Agent Ledger",
  "version": "0.1.0",
  "description": "Keeps a local, independently observed record of what AI agents do in Chrome.",
  "homepage_url": "https://github.com/toddsherman/agent-ledger",
  "key": "",
  "minimum_chrome_version": "120",
  "background": {
    "service_worker": "background/main.js"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "webNavigation",
    "debugger",
    "downloads",
    "management",
    "nativeMessaging",
    "storage",
    "alarms",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "lib/redact.js",
        "lib/describe-element.js",
        "content/capture.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "Agent Ledger",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
